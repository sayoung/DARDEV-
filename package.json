{
  "name": "xplor",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "fastify@<5.12.2": ">=5.12.2",
      "happy-dom@<21.0.4": ">=21.0.4",
      "source-map-js@<1.2.2": ">=1.2.2",
      "tinypool@<2.1.2": ">=2.1.2",
      "undici@<8.12.2": ">=8.12.2",
      "vite@>=7.0.0 <7.3.7": ">=7.3.7",
      "vite@>=8.0.0 <8.3.3": ">=8.3.3",
      "zod@<4.6.6": ">=4.6.6"
    }
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:int": "pnpm --filter @xplor/api test:int",
    "test:e2e": "playwright test",
    "dev": "pnpm --parallel --filter @xplor/api --filter @xplor/admin --filter @xplor/web --filter @xplor/kiosk --filter @xplor/worker dev",
    "db:migrate": "pnpm -r db:migrate",
    "db:deploy": "pnpm -r db:deploy",
    "db:generate": "pnpm -r db:generate",
    "db:seed": "pnpm -r db:seed",
    "demo:m2": "tsx --conditions=development scripts/demo-m2-upload.ts",
    "import:oudayas": "tsx --conditions=development scripts/oudayas/import.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xplor/shared": "workspace:^",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
