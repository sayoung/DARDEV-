{
  "name": "xplor",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:int": "pnpm --filter @xplor/api test:int",
    "test:e2e": "playwright test",
    "dev": "pnpm --parallel --filter @xplor/api --filter @xplor/admin --filter @xplor/web --filter @xplor/kiosk --filter @xplor/worker dev",
    "db:migrate": "pnpm -r db:migrate",
    "db:deploy": "pnpm -r db:deploy",
    "db:generate": "pnpm -r db:generate",
    "db:seed": "pnpm -r db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
