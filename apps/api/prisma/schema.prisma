generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  HOTEL_MANAGER
  PARTNER
}

model User {
  id               String      @id @default(uuid(7)) @db.Uuid
  email            String      @unique
  name             String
  passwordHash     String
  role             Role
  totpSecret       String?
  totpEnabled      Boolean     @default(false)
  lastLoginAt      DateTime?
  active           Boolean     @default(true)
  uiLang           String      @default("fr")
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tokens           UserToken[]
  toursCreated     Tour[]      @relation("TourCreatedBy")
  scenesCreated    Scene[]     @relation("SceneCreatedBy")
  hotspotsCreated  Hotspot[]   @relation("HotspotCreatedBy")
  hotels           UserHotel[]
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

/// Jeton d'invitation ou de réinitialisation. Seule l'empreinte est persistée.
model UserToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserTokenType
  /// Empreinte SHA-256 hexadécimale. Le jeton en clair n'est jamais stocké.
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum TourStatus {
  DRAFT
  PUBLISHED
}

enum HotspotType {
  SCENE_LINK
  TOUR_LINK
  INFO
  MEDIA
  URL
}

enum HotspotIcon {
  ARROW
  INFO
  PHOTO
  PLAY
  PORTAL
}

enum AssetKind {
  PANORAMA
  IMAGE
  AUDIO
  VIDEO
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

/// Ville ou zone (cahier, 5.1). Suppression physique.
model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// LocalizedText { fr, ar?, en? }.
  name      Json
  region    String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tours     Tour[]
  hotels    Hotel[]
}

/// Catégorie de visite (cahier, 5.1). Suppression physique.
model Category {
  id        String         @id @default(uuid(7)) @db.Uuid
  /// LocalizedText { fr, ar?, en? }.
  name      Json
  icon      String
  /// Couleur d'accent `#` + 6 hexadécimaux, contrôlée par Zod.
  color     String
  weight    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tours     TourCategory[]
}

/// Média minimal (D-65). L'upload et le traitement arrivent en M2.
model Asset {
  id               String           @id @default(uuid(7)) @db.Uuid
  kind             AssetKind
  originalKey      String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  contentHash      String
  processingStatus ProcessingStatus @default(PENDING)
  derivatives      Json             @default("{}")
  copyright        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  coverOf          Tour[]           @relation("TourCover")
  panoramas        Scene[]          @relation("ScenePanorama")
  ambientOf        Scene[]          @relation("SceneAmbient")
  hotelLogos       Hotel[]          @relation("HotelLogo")
}

/// Visite virtuelle (cahier, 5.2). Suppression logique via deletedAt.
model Tour {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// LocalizedText { fr, ar?, en? }.
  title           Json
  /// LocalizedText, 500 caractères par langue (Zod).
  summary         Json
  description     Json?
  cityId          String         @db.Uuid
  city            City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  categories      TourCategory[]
  coverAssetId    String         @db.Uuid
  coverAsset      Asset          @relation("TourCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  /// Facultatif tant que la visite n'est pas publiée.
  startSceneId    String?        @db.Uuid
  startScene      Scene?         @relation("TourStartScene", fields: [startSceneId], references: [id], onDelete: SetNull)
  durationMinutes Int?
  lat             Float?
  lng             Float?
  practicalInfo   Json?
  /// 22 caractères, émis plus tard par le service (nanoid). Null tant qu'il n'existe pas.
  shareToken      String?        @unique @db.VarChar(22)
  publicShare     Boolean        @default(false)
  contentVersion  Int            @default(1)
  status          TourStatus     @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdById     String         @db.Uuid
  createdBy       User           @relation("TourCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  scenes             Scene[]         @relation("TourScenes")
  targetedBy         Hotspot[]       @relation("HotspotTargetTour")
  featuredSelections Selection[]     @relation("SelectionFeaturedTour")
  selectionItems     SelectionItem[]

  @@index([cityId])
  @@index([coverAssetId])
  @@index([startSceneId])
  @@index([createdById])
}

/// Jointure explicite visite ↔ catégorie. Suppression physique avec la visite.
model TourCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  tourId     String   @db.Uuid
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tourId, categoryId])
  @@index([tourId])
  @@index([categoryId])
}

/// Scène : un panorama 360° (cahier, 5.3). Suppression logique via deletedAt.
model Scene {
  id              String    @id @default(uuid(7)) @db.Uuid
  tourId          String    @db.Uuid
  tour            Tour      @relation("TourScenes", fields: [tourId], references: [id], onDelete: Restrict)
  /// LocalizedText { fr, ar?, en? }.
  title           Json
  caption         Json?
  panoramaAssetId String    @db.Uuid
  panoramaAsset   Asset     @relation("ScenePanorama", fields: [panoramaAssetId], references: [id], onDelete: Restrict)
  initialYaw      Float     @default(0)
  initialPitch    Float     @default(0)
  initialZoom     Int       @default(50)
  /// Pistes audio par langue : { fr?: assetId, ar?: assetId, en?: assetId }.
  narration       Json?
  ambientAssetId  String?   @db.Uuid
  ambientAsset    Asset?    @relation("SceneAmbient", fields: [ambientAssetId], references: [id], onDelete: SetNull)
  mapX            Float?
  mapY            Float?
  weight          Int
  deletedAt       DateTime?
  createdById     String    @db.Uuid
  createdBy       User      @relation("SceneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hotspots        Hotspot[] @relation("HotspotScene")
  targetedBy      Hotspot[] @relation("HotspotTargetScene")
  arrivalFor      Hotspot[] @relation("HotspotTargetTourScene")
  startOf         Tour[]    @relation("TourStartScene")

  @@index([tourId])
  @@index([panoramaAssetId])
  @@index([ambientAssetId])
  @@index([createdById])
}

/// Point cliquable dans une scène (cahier, 5.4). Suppression physique.
model Hotspot {
  id                String      @id @default(uuid(7)) @db.Uuid
  sceneId           String      @db.Uuid
  scene             Scene       @relation("HotspotScene", fields: [sceneId], references: [id], onDelete: Cascade)
  type              HotspotType
  yaw               Float
  pitch             Float
  /// LocalizedText { fr, ar?, en? }.
  label             Json
  targetSceneId     String?     @db.Uuid
  targetScene       Scene?      @relation("HotspotTargetScene", fields: [targetSceneId], references: [id], onDelete: SetNull)
  targetTourId      String?     @db.Uuid
  targetTour        Tour?       @relation("HotspotTargetTour", fields: [targetTourId], references: [id], onDelete: SetNull)
  targetTourSceneId String?     @db.Uuid
  targetTourScene   Scene?      @relation("HotspotTargetTourScene", fields: [targetTourSceneId], references: [id], onDelete: SetNull)
  body              Json?
  mediaAssetIds     String[]    @default([])
  url               String?
  icon              HotspotIcon
  arrivalYaw        Float?
  createdById       String      @db.Uuid
  createdBy         User        @relation("HotspotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([sceneId])
  @@index([targetSceneId])
  @@index([targetTourId])
  @@index([targetTourSceneId])
  @@index([createdById])
}

enum HotelStars {
  FOUR
  FIVE
  LUXURY
}

enum ContractType {
  SALE
  RENTAL
}

/// Hôtel client (cahier, 5.6). Suppression logique via deletedAt.
model Hotel {
  id                 String       @id @default(uuid(7)) @db.Uuid
  name               String
  stars              HotelStars
  cityId             String       @db.Uuid
  city               City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  address            String
  phone              String
  email              String
  logoAssetId        String?      @db.Uuid
  logoAsset          Asset?       @relation("HotelLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  /// Couleur d'accent `#` + 6 hexadécimaux, contrôlée par Zod.
  brandColor         String
  /// Codes de langue ; le premier est la langue par défaut.
  languages          String[]     @default(["fr"])
  contractType       ContractType
  contractStart      DateTime
  contractEnd        DateTime
  /// PIN de l'écran technique, haché argon2. Null tant qu'aucun PIN n'est défini.
  maintenancePinHash String?
  active             Boolean      @default(true)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  selection          Selection?
  kiosks             Kiosk[]
  managers           UserHotel[]

  @@index([cityId])
  @@index([logoAssetId])
}

/// Sélection de visites d'un hôtel (cahier, 5.7). Une seule par hôtel en phase 1.
model Selection {
  id             String          @id @default(uuid(7)) @db.Uuid
  hotelId        String          @unique @db.Uuid
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  featuredTourId String?         @db.Uuid
  featuredTour   Tour?           @relation("SelectionFeaturedTour", fields: [featuredTourId], references: [id], onDelete: SetNull)
  attractTourIds String[]        @default([])
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          SelectionItem[]

  @@index([featuredTourId])
}

/// Ligne ordonnée de la sélection. Suppression physique avec la sélection.
model SelectionItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  selectionId String    @db.Uuid
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  tourId      String    @db.Uuid
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Restrict)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([selectionId, tourId])
  @@index([selectionId])
  @@index([tourId])
}

enum KioskDeviceType {
  TOUCH_SCREEN
  VR_HEADSET
  TOUCH_AND_HEADSET
}

enum KioskStatus {
  PENDING
  ACTIVE
  DISABLED
}

/// Kiosque (cahier, 5.8). Suppression logique via deletedAt.
model Kiosk {
  id                    String          @id @default(uuid(7)) @db.Uuid
  label                 String
  hotelId               String          @db.Uuid
  hotel                 Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  deviceType            KioskDeviceType
  status                KioskStatus     @default(PENDING)
  enrollmentCode        String?         @unique @db.VarChar(8)
  enrollmentExpiresAt   DateTime?
  /// Empreinte SHA-256 du jeton d'appareil. Le jeton en clair n'est jamais stocké.
  tokenHash             String?         @unique
  lastHeartbeatAt       DateTime?
  lastIp                String?
  appVersion            String?
  syncedManifestVersion String?
  storageFreeMb         Int?
  idleTimeoutSeconds    Int             @default(90)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([hotelId])
}

/// Rattachement gestionnaire ↔ hôtel (cahier, 5.10). Clé composite.
model UserHotel {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String   @db.Uuid
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, hotelId])
  @@index([hotelId])
}
