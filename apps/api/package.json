{
  "name": "@xplor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=development watch src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "prebuild": "pnpm --filter @xplor/shared build && pnpm --filter @xplor/i18n build && prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "openapi": "tsx --conditions=development src/openapi/write-openapi.ts",
    "cli": "tsx --conditions=development src/cli/main.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=development prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "^6.19.3",
    "@xplor/i18n": "workspace:*",
    "@xplor/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "fastify": "5.11.3",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.6",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
