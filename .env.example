# Variables d'environnement du projet Xplor.
# Copier ce fichier en .env pour un poste local.
# .env est ignoré par git ; ne jamais y mettre de secret versionné.
# Les valeurs ci-dessous sont celles du développement local uniquement.

# API NestJS (préfixe /api/v1). NODE_ENV vaut development s'il est absent.
PORT=3000

# PostgreSQL (aligné sur le service postgres de docker-compose.yml)
POSTGRES_USER=xplor
POSTGRES_PASSWORD=xplor
POSTGRES_DB=xplor
DATABASE_URL=postgresql://xplor:xplor@localhost:5432/xplor
DATABASE_URL_TEST=postgresql://xplor:xplor@localhost:5432/xplor_test

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (API S3). La console web est sur http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=xplor
S3_SECRET_KEY=xplor-dev-secret
S3_BUCKET=xplor

# Mailpit (SMTP local ; interface web http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Secret de session du back-office (développement local uniquement)
SESSION_SECRET=dev-only-session-secret-not-for-production

# Back-office (Vite). Liens des courriels d'invitation et de réinitialisation.
ADMIN_BASE_URL=http://localhost:5173

# Mot de passe des quatre comptes créés par pnpm db:seed (développement local uniquement).
# Au moins 12 caractères, et absent de la liste des mots de passe courants.
SEED_DEFAULT_PASSWORD=xplor-seed-dev-2026

# Storage
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=storage
API_PUBLIC_URL=http://localhost:3000

# URL publique des médias (sans / final)
MEDIA_PUBLIC_URL=http://localhost:9000/xplor

# URL publique de l'application web (sans / final)
PUBLIC_WEB_URL=http://localhost:5174
