    "/api/v1/admin/users/invitations": {
      "post": {
        "summary": "Inviter un utilisateur",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Compte à créer, inactif jusqu’à l’acceptation.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
