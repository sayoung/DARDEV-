                  "required": [
                    "id",
                    "email",
                    "name",
                    "role",
                    "uiLang",
                    "csrfToken"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Session absente, ou compte introuvable ou inactif (INVALID_CREDENTIALS).",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "statusCode": {
                          "type": "number",
                          "enum": [
                            401
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "error": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "statusCode",
                        "message",
                        "error"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "statusCode": {
                          "type": "number",
                          "enum": [
                            401
                          ]
                        },
                        "code": {
                          "type": "string",
                          "enum": [
                            "INVALID_CREDENTIALS"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "enum": [
                            "INVALID_CREDENTIALS"
                          ]
                        }
                      },
                      "required": [
                        "statusCode",
                        "code",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "summary": "Demander un lien de réinitialisation",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "description": "Adresse du compte.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande acceptée. Corps vide, que le compte existe, soit inactif, ou que l’envoi échoue."
          },
          "400": {
            "description": "Corps refusé par ForgotPasswordRequestSchema.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        400
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Plus de 5 requêtes par minute pour cette adresse IP."
          }
        }
      }
    },
