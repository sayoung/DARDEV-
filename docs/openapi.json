                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "ADMIN",
                        "EDITOR",
                        "HOTEL_MANAGER",
                        "PARTNER"
                      ]
                    },
                    "uiLang": {
                      "type": "string",
