{
  "openapi": "3.1.0",
  "info": {
    "title": "Xplor API",
    "version": "0.0.0",
    "description": "Généré depuis les schémas Zod de @xplor/shared. Les corps de requête et de réponse ne sont pas redéclarés."
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "xplor_sid",
        "description": "Cookie de session httpOnly. La valeur est un identifiant opaque."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Jeton CSRF de la session courante. Exigé pour toute méthode autre que GET, HEAD ou OPTIONS."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Santé de la base, de Redis et du stockage",
        "tags": [
          "Santé"
        ],
        "responses": {
          "200": {
            "description": "Les trois sondes répondent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "db": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "storage": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        }
                      },
                      "required": [
                        "db",
                        "redis",
                        "storage"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Au moins une sonde a échoué ou dépassé le délai de 2 s.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "db": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "storage": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        }
                      },
                      "required": [
                        "db",
                        "redis",
                        "storage"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Ouvrir une session",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "description": "Identifiants du compte.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session créée. Le cookie xplor_sid est posé.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "ADMIN",
                        "EDITOR",
                        "HOTEL_MANAGER",
                        "PARTNER"
                      ]
                    },
                    "uiLang": {
                      "type": "string",
                      "enum": [
                        "fr",
                        "ar",
                        "en"
                      ]
                    },
                    "csrfToken": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "name",
                    "role",
                    "uiLang",
                    "csrfToken"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Corps refusé par LoginRequestSchema.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        400
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Identifiants refusés ou compte inactif.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        401
                      ]
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "INVALID_CREDENTIALS"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "INVALID_CREDENTIALS"
                      ]
                    }
                  },
                  "required": [
                    "statusCode",
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "423": {
            "description": "Compte verrouillé.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        423
                      ]
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "ACCOUNT_LOCKED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "ACCOUNT_LOCKED"
                      ]
                    }
                  },
                  "required": [
                    "statusCode",
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Plus de 5 requêtes par minute pour cette adresse IP."
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Fermer la session",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session détruite et cookie retiré. Corps vide."
          },
          "401": {
            "description": "Session absente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        401
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Jeton CSRF refusé.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "enum": [
                        403
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
