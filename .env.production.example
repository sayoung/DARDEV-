# Mode et ports
NODE_ENV=production
PORT=3000

# Base de données PostgreSQL
POSTGRES_USER=xplor_prod
POSTGRES_PASSWORD=CHANGER_MOI
POSTGRES_DB=xplor_prod
DATABASE_URL=postgresql://xplor_prod:CHANGER_MOI@postgres:5432/xplor_prod

# Redis (BullMQ, cache)
REDIS_URL=redis://redis:6379

# Stockage MinIO / S3
MINIO_ROOT_USER=CHANGER_MOI
MINIO_ROOT_PASSWORD=CHANGER_MOI
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGER_MOI
S3_SECRET_KEY=CHANGER_MOI
S3_BUCKET=xplor
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=

# Sécurité et mots de passe par défaut
SESSION_SECRET=CHANGER_MOI
SEED_DEFAULT_PASSWORD=CHANGER_MOI

# Serveur de messagerie (SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025

# URLs de l'infrastructure
ADMIN_BASE_URL=https://admin.xplor.ma
API_PUBLIC_URL=https://api.xplor.ma
MEDIA_PUBLIC_URL=https://media.xplor.ma/xplor
PUBLIC_WEB_URL=https://v.xplor.ma
VITE_PUBLIC_WEB_URL=https://v.xplor.ma
API_CORS_ORIGINS=https://admin.xplor.ma,https://v.xplor.ma

# Déploiement Caddy / TLS et sites de démo
ACME_EMAIL=CHANGER_MOI
DEMO_SITE_DIR=/var/www/demo
